{
  // Markdown linting — relaxed for docs/prose with tables and long lines.
  "config": {
    "default": true,
    "MD013": false, // line length — prose & tables run long
    "MD033": false, // inline HTML allowed
    "MD036": false, // bold sub-labels used intentionally in design docs
    "MD041": false, // first line need not be a top-level heading
    "MD024": { "siblings_only": true }, // duplicate headings ok across sections
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "archive"],
}
